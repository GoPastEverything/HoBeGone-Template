    "youtu.be",
    "instagram.com",
    "facebook.com",
    "tiktok.com",
    "linkedin.com",
    "google.com",
    "apple.com",
    "github.com",
    "medium.com",
    "substack.com",
    "linktr.ee",
    "discord.gg",
    "discord.com"
  ],
