      "type": "string"
    },
    "STATUS": {
      "enum": [
        "PENDING",
        "DONE"
      ]
    },
    "BLOCK_BASIS_FEATURES": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "BASIS_BEHAVIOR_TYPES": {
      "type": "array",
      "items": {
        "enum": [
          "PROFILE_HISTORY",
          "ORIGINAL_POSTS",
          "REPLIES",
          "REPOSTS",
          "QUOTES",
          "EXTERNAL_LINKS",
          "OLDER_CONTENT"
        ]
      }
    },
    "AVAILABLE_BEHAVIOR_TYPES": {
      "type": "array",
      "items": {
        "enum": [
          "PROFILE_HISTORY",
          "ORIGINAL_POSTS",
          "REPLIES",
          "REPOSTS",
          "QUOTES",
          "EXTERNAL_LINKS",
          "OLDER_CONTENT"
        ]
      }
    },
    "SAMPLED_BEHAVIOR_TYPES": {
      "type": "array",
