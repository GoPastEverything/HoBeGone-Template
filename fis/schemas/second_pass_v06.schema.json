{
  "title": "v0.6 second-pass record (adaptive completion)",
  "type": "object",
  "required": [
    "HANDLE",
    "STATUS",
    "BLOCK_BASIS_FEATURES",
    "AVAILABLE_BEHAVIOR_TYPES",
    "SAMPLED_BEHAVIOR_TYPES",
    "UNOBSERVABLE_BEHAVIOR_TYPES",
    "ALL_AVAILABLE_EXAMINED",
    "QUOTE_REVERIFICATIONS",
    "DISPROOF_CHECKS",
