        "enum": [
          "PROFILE_HISTORY",
          "ORIGINAL_POSTS",
          "REPLIES",
          "REPOSTS",
          "QUOTES",
          "EXTERNAL_LINKS",
          "OLDER_CONTENT"
        ]
      }
    },
    "UNOBSERVABLE_BEHAVIOR_TYPES": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "TYPE",
          "REASON"
        ],
        "properties": {
          "TYPE": {
            "enum": [
              "PROFILE_HISTORY",
              "ORIGINAL_POSTS",
              "REPLIES",
              "REPOSTS",
              "QUOTES",
              "EXTERNAL_LINKS",
              "OLDER_CONTENT"
            ]
          },
          "REASON": {
            "type": "string",
            "pattern": ".+"
          }
        }
      }
    },
    "ALL_AVAILABLE_EXAMINED": {
      "type": "boolean"
    },
    "ITEMS_EXAMINED": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "UNKNOWN"
        }
      ]
    },
    "QUOTE_REVERIFICATIONS": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "FEATURE_ID",
          "QUOTE",
          "METHOD",
          "VERBATIM"
        ],
        "properties": {
          "METHOD": {
